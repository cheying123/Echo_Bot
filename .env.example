# QQ AI Bot 环境变量配置
# 复制为 .env 并填入实际值（已添加到 .gitignore 建议）

# ----- AI API 配置（推荐用环境变量方式）-----
AIBOT_LLM__API_KEY=sk-your-api-key-here

# 厂商选择: openai / deepseek / moonshot / qwen / ollama
AIBOT_LLM__PROVIDER=deepseek

# 自定义 API 地址（可选项，不填则使用厂商预设）
# AIBOT_LLM__BASE_URL=https://api.deepseek.com/v1
# AIBOT_LLM__MODEL=deepseek-chat

# ----- 代理（访问外网 API 时使用）-----
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ----- go-cqhttp 配置 -----
# AIBOT_SERVER__WS_PORT=8765
# AIBOT_SERVER__HTTP_API_URL=http://127.0.0.1:5700
